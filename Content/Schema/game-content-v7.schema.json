{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/game-content-v7.schema.json",
  "title": "Game content catalog v7",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contentVersion",
    "status",
    "playerMaximumHealth",
    "rewardChoiceCount",
    "startNodeId",
    "startRouteNodeId",
    "initialDeck",
    "rewardPool",
    "initialRelics",
    "cards",
    "statuses",
    "relics",
    "shops",
    "enemies",
    "encounters",
    "routeNodes",
    "storyNodes"
  ],
  "properties": {
    "schemaVersion": { "const": 7 },
    "contentVersion": { "type": "string", "minLength": 1 },
    "status": { "enum": ["draft", "review", "approved", "deprecated"] },
    "playerMaximumHealth": { "type": "integer", "minimum": 1 },
    "rewardChoiceCount": { "type": "integer", "minimum": 1 },
    "startNodeId": { "$ref": "#/$defs/contentId" },
    "startRouteNodeId": { "$ref": "#/$defs/contentId" },
    "initialDeck": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/contentId" } },
    "rewardPool": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/contentId" } },
    "initialRelics": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/contentId" } },
    "cards": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/card" } },
    "statuses": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/status" } },
    "relics": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/relic" } },
    "shops": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/shop" } },
    "enemies": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/enemy" } },
    "encounters": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/encounter" } },
    "routeNodes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/routeNode" } },
    "storyNodes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/storyNode" } }
  },
  "$defs": {
    "contentId": {
      "type": "string",
      "maxLength": 96,
      "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z][a-z0-9_-]*)+$"
    },
    "card": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "nameKey", "descriptionKey", "metadata", "cost", "effects"],
      "properties": {
        "id": { "$ref": "#/$defs/contentId" },
        "nameKey": { "$ref": "#/$defs/contentId" },
        "descriptionKey": { "$ref": "#/$defs/contentId" },
        "metadata": { "$ref": "#/$defs/metadata" },
        "cost": { "type": "integer", "minimum": 0 },
        "exhausts": { "type": "boolean" },
        "upgradeToId": { "$ref": "#/$defs/contentId" },
        "effects": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/cardEffect" } }
      }
    },
    "cardEffect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "target", "amount"],
      "properties": {
        "kind": { "enum": ["Damage", "Block", "Draw", "ApplyStatus"] },
        "target": { "enum": ["Self", "SingleEnemy", "AllEnemies"] },
        "amount": { "type": "integer", "minimum": 1 },
        "statusId": { "$ref": "#/$defs/contentId" }
      }
    },
    "status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "nameKey", "descriptionKey", "metadata"],
      "properties": {
        "id": { "$ref": "#/$defs/contentId" },
        "kind": { "enum": ["Strength", "Weak", "Vulnerable"] },
        "nameKey": { "$ref": "#/$defs/contentId" },
        "descriptionKey": { "$ref": "#/$defs/contentId" },
        "metadata": { "$ref": "#/$defs/metadata" }
      }
    },
    "relic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "trigger", "nameKey", "descriptionKey", "metadata", "effects"],
      "properties": {
        "id": { "$ref": "#/$defs/contentId" },
        "trigger": { "const": "CombatStart" },
        "nameKey": { "$ref": "#/$defs/contentId" },
        "descriptionKey": { "$ref": "#/$defs/contentId" },
        "metadata": { "$ref": "#/$defs/metadata" },
        "effects": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/relicEffect" } }
      }
    },
    "relicEffect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "amount"],
      "properties": {
        "kind": { "enum": ["GainBlock", "ApplyStatus"] },
        "amount": { "type": "integer", "minimum": 1 },
        "statusId": { "$ref": "#/$defs/contentId" }
      }
    },
    "shop": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "nameKey", "descriptionKey", "metadata", "inventoryPool", "cardPrice", "removalPrice", "offerCount"],
      "properties": {
        "id": { "$ref": "#/$defs/contentId" },
        "nameKey": { "$ref": "#/$defs/contentId" },
        "descriptionKey": { "$ref": "#/$defs/contentId" },
        "metadata": { "$ref": "#/$defs/metadata" },
        "inventoryPool": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/contentId" } },
        "cardPrice": { "type": "integer", "minimum": 1 },
        "removalPrice": { "type": "integer", "minimum": 1 },
        "offerCount": { "type": "integer", "minimum": 1 }
      }
    },
    "enemy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "nameKey", "descriptionKey", "metadata", "maximumHealth", "intents"],
      "properties": {
        "id": { "$ref": "#/$defs/contentId" },
        "nameKey": { "$ref": "#/$defs/contentId" },
        "descriptionKey": { "$ref": "#/$defs/contentId" },
        "metadata": { "$ref": "#/$defs/metadata" },
        "maximumHealth": { "type": "integer", "minimum": 1 },
        "intents": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/enemyIntent" } }
      }
    },
    "enemyIntent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "effects"],
      "properties": {
        "id": { "$ref": "#/$defs/contentId" },
        "effects": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/enemyIntentEffect" } }
      }
    },
    "enemyIntentEffect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "target", "amount"],
      "properties": {
        "kind": { "enum": ["Attack", "GainBlock", "ApplyStatus"] },
        "target": { "enum": ["Self", "Player"] },
        "amount": { "type": "integer", "minimum": 1 },
        "statusId": { "$ref": "#/$defs/contentId" }
      }
    },
    "encounter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "nameKey", "descriptionKey", "metadata", "enemyIds"],
      "properties": {
        "id": { "$ref": "#/$defs/contentId" },
        "nameKey": { "$ref": "#/$defs/contentId" },
        "descriptionKey": { "$ref": "#/$defs/contentId" },
        "metadata": { "$ref": "#/$defs/metadata" },
        "enemyIds": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/contentId" } }
      }
    },
    "routeNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "nameKey", "descriptionKey", "metadata"],
      "properties": {
        "id": { "$ref": "#/$defs/contentId" },
        "kind": { "enum": ["Story", "Combat", "Boss", "Rest", "Shop"] },
        "payloadId": { "$ref": "#/$defs/contentId" },
        "nameKey": { "$ref": "#/$defs/contentId" },
        "descriptionKey": { "$ref": "#/$defs/contentId" },
        "metadata": { "$ref": "#/$defs/metadata" },
        "nextNodeIds": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/contentId" } },
        "isFinal": { "type": "boolean" }
      }
    },
    "storyNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "speakerKey", "textKey", "metadata"],
      "properties": {
        "id": { "$ref": "#/$defs/contentId" },
        "speakerKey": { "$ref": "#/$defs/contentId" },
        "textKey": { "$ref": "#/$defs/contentId" },
        "metadata": { "$ref": "#/$defs/metadata" },
        "isTerminal": { "type": "boolean" },
        "onEnter": { "type": "array", "items": { "$ref": "#/$defs/command" } },
        "choices": { "type": "array", "items": { "$ref": "#/$defs/choice" } }
      }
    },
    "choice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "textKey", "nextNodeId"],
      "properties": {
        "id": { "$ref": "#/$defs/contentId" },
        "textKey": { "$ref": "#/$defs/contentId" },
        "nextNodeId": { "$ref": "#/$defs/contentId" },
        "conditions": { "type": "array", "items": { "$ref": "#/$defs/condition" } },
        "commands": { "type": "array", "items": { "$ref": "#/$defs/command" } }
      }
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["variableId", "operation"],
      "properties": {
        "variableId": { "$ref": "#/$defs/contentId" },
        "operation": { "enum": ["Exists", "Equals", "NotEquals", "GreaterOrEqual"] },
        "value": { "$ref": "#/$defs/storyValue" }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["SetVariable", "AddInteger", "GrantCard", "GrantRelic", "StartCombat", "ChangeResource"] },
        "key": { "$ref": "#/$defs/contentId" },
        "payload": { "$ref": "#/$defs/contentId" },
        "amount": { "type": "integer" },
        "value": { "$ref": "#/$defs/storyValue" }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "source", "tags"],
      "properties": {
        "owner": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "tags": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "storyValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["Boolean", "Integer", "Text"] },
        "boolean": { "type": "boolean" },
        "integer": { "type": "integer" },
        "text": { "type": "string" }
      }
    }
  }
}
